# Server-only variables for this independent drast project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative (use one server key only):
# SUPABASE_SERVICE_ROLE_KEY=
# Optional isolated provider override; Vercel OIDC is attempted by default.
# OPENROUTER_API_KEY=
# DRAST_FREE_MODEL=openrouter/free
DRAST_PRIVATE_WORKSPACE=enabled
